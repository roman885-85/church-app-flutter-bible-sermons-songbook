<?xml version="1.0" encoding="utf-8"?>
<!--
  Ярлики на значку застосунку (довгий натиск, Android 7.1+): те, по що
  приходять під час служіння, — за один дотик. Ярлик відкриває MainActivity з
  extra "open", як і сповіщення (lib/screens/shell.dart, _openFromAlert).
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="songbook"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_songbook"
        android:shortcutShortLabel="@string/shortcut_songbook"
        android:shortcutLongLabel="@string/shortcut_songbook">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ua.com.baptist.church"
            android:targetClass="ua.com.baptist.church.MainActivity">
            <extra android:name="open" android:value="tab:songbook"/>
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="bible"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_bible"
        android:shortcutShortLabel="@string/shortcut_bible"
        android:shortcutLongLabel="@string/shortcut_bible">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ua.com.baptist.church"
            android:targetClass="ua.com.baptist.church.MainActivity">
            <extra android:name="open" android:value="tab:bible"/>
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="live"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_live"
        android:shortcutShortLabel="@string/shortcut_live"
        android:shortcutLongLabel="@string/shortcut_live_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ua.com.baptist.church"
            android:targetClass="ua.com.baptist.church.MainActivity">
            <extra android:name="open" android:value="live"/>
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ua.com.baptist.church"
            android:targetClass="ua.com.baptist.church.MainActivity">
            <extra android:name="open" android:value="search"/>
        </intent>
    </shortcut>
</shortcuts>
