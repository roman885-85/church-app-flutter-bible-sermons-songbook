<?xml version="1.0" encoding="utf-8"?>
<!--
  audio_service шукає іконки кнопок сповіщення за іменем (getIdentifier), тож
  R8 вважає їх невикористаними й вирізає. Тоді кнопки «пауза/стоп» не
  будуються («You must specify an icon resource id to build a CustomAction»),
  і плеєр на екрані блокування та в сповіщенні не працює.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_stat_audio,@mipmap/ic_launcher,@mipmap/ic_launcher_foreground" />
